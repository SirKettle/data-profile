{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["bun-types"],
    // Each package imports the others, and examples import their own, by published name; resolve
    // those to source, so nothing needs building first. Relative to this file.
    "paths": {
      "@data-profile/core": ["./packages/core/src/index.ts"],
      "@data-profile/react": ["./packages/react/src/index.ts"],
      "@data-profile/fingerprint": ["./packages/fingerprint/src/index.ts"],
      "@data-profile/fingerprint/react": ["./packages/fingerprint/src/react/index.ts"],
      "@data-profile/waffle": ["./packages/waffle/src/index.ts"],
      "@data-profile/waffle/react": ["./packages/waffle/src/react/index.ts"]
    }
  }
}
