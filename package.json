{
  "name": "data-profile",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "test": "bun test",
    "typecheck": "bun run --filter './packages/*' typecheck && tsc --noEmit -p site/src/demos",
    "api:report": "bun run --filter './packages/*' api:report",
    "lint:package": "bun run --filter './packages/*' lint:package",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "bun run scripts/check-docs.ts"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-types": "^1.3.14",
    "prettier": "3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3"
  }
}
